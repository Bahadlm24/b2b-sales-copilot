server {
    listen 443 ssl http2;
    server_name crm.example.com;

    ssl_certificate     /etc/ssl/certs/crm.example.com.crt;
    ssl_certificate_key /etc/ssl/private/crm.example.com.key;

    root /var/www/sales-copilot;
    index index.html;

    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
    add_header X-Frame-Options DENY;

    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /runtime-config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# API ayrı bir origin ise örnek CORS (backend sunucusuna yazılır)
# add_header Access-Control-Allow-Origin "https://crm.example.com";
# add_header Access-Control-Allow-Headers "Authorization, Content-Type";
# add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS";
