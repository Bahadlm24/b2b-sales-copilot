# Yerel sırlar ve makineye özel değerler. Bu dosyayı kopyalayıp .env yapın.
# Sunucuya atılacak paket `npm run build` çıktısıdır; canlıda asıl düzenlenen dosya dist/runtime-config.js olur.

# Uygulama kök yolu. Alt klasöre kuruyorsanız örn. /copilot/
VITE_APP_BASE=/

# local | live-static | live
VITE_APP_MODE=local

# Backend API kökü. Canlı statik testte boş bırakılabilir.
# Örn. https://crm.example.com/api
VITE_API_BASE_URL=

# Kullanıcıların tarayıcıda açacağı adres. Eklenti ve webhook dokümantasyonu için.
# Örn. https://crm.example.com
VITE_APP_PUBLIC_URL=

# local = tarayıcı localStorage. api = ilerideki backend kalıcılığı.
VITE_PERSIST_MODE=local

# Varsayılan arayüz dili: tr | en. Boş bırakılırsa tarayıcı dili, yoksa Türkçe.
# Kullanıcı seçimi localStorage'da saklanır ve bu değeri ezer.
VITE_APP_LOCALE=
