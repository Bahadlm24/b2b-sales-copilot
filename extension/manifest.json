{
  "manifest_version": 3,
  "name": "Sales Copilot Meeting Assistant",
  "version": "0.6.0",
  "description": "Meet, Teams ve Zoom görüşmelerini müşteri bağlamıyla notlar ve Sales Copilot sistemine aktarır.",
  "permissions": ["storage", "sidePanel", "tabs", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "https://*.zoom.us/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Sales Copilot'u aç" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*", "https://*.zoom.us/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
